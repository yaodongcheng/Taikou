<!-- Taikou 的动画接线正本之二：动作名 → 动画 clip 的绑定。

     引擎行为（反编译 TaleWorlds.MountAndBlade.Module.CreateProcessedActionSetsXMLForNative 实证）：
       同 id 的 <action_set> 由 C# 层【追加合并】进第一个 —— 我们这一条会被 Add() 进 Native 的
       as_human_warrior 里，原版几千个动作一条都不会被挤掉。

     🔴 animation= 填的是【动画 clip 名】，不是 FBX take 名、不是骨架动画（SkeletonAnimation）资源名。
        写错 = 静默解析成 act_none，没有任何报错，只是播不出来。

     🔴 2026-09-19 启用。为什么不会重演 09-08 那次崩：见 action_types.xml 的说明（零交集、纯追加）。
     回退方法：删掉 mbproj 里 soln_action_sets 那一行即可。 -->
<action_sets>
	<action_set
		id="as_human_warrior"
		skeleton="human_skeleton"
		movement_system="bipedal">
		<action
			type="act_gun_reload"
			animation="gun_reload" />

		<!-- 🔴 2026-09-20 新增：飞行待机（阶段 1A 探针）。
		     animation= 填的是**实测出来的 clip 名**（tpaccli list 装机包得到 `flight_idle_a`），
		     不是计划文档早期建议的 `fly_idle`、不是 TRF/FBX 文件名。写错 = 静默 act_none。 -->
		<action
			type="act_fly_idle"
			animation="flight_idle_a" />

		<!-- 🔴 2026-09-20 新增：处决动画（T17「带位移动画」实验的载体）。
		     animation= 填的是**实测出来的 clip 名**（用 tpaccli clipinfo 读装机包，挑出
		     AnimationClip 类型的资产名 = `execution_02`；它挂的 SkeletalAnimation = `gs_execution02_root`，
		     即带位移的 Root 变体）。写错 = 静默 act_none、do_anim 会报 duration 0.00s。
		     🔴 本条注释里【不许出现连续两个减号】：XML 注释里那是非法字符，整个文件解析失败、
		     引擎启动即崩（XmlException @ CreateProcessedActionSetsXMLForNative）。要提命令行参数就只写名字、不带杠。 -->
		<action
			type="act_execution02_root"
			animation="execution_02" />
	</action_set>
</action_sets>
