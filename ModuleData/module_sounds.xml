	<!-- ================= 火器音效（2026-09-15 火器工程） =================
	     音频文件借自织丰（原路径 Shokuho/ModuleSounds/sho_*.wav），已拷进本模块 —— 运行时零依赖织丰。
	     文件名保留 sho_ 前缀 = 标明来源（以后要替换成自制音效时按前缀就能找全）；
	     逻辑名用 tk_ 前缀，与织丰的命名空间隔开。
	     🔴 LWN 侧不硬编码任何音效名：档位（near/mid/far/粒子）全部走
	        ModuleData/AssetRegistry/FirearmFx.xml 契约读取（铁律 3：基座不认世界观词汇）。
	     分档用法：射手到玩家的距离 < nearDist 用 near、> farDist 用 far、中间用 mid。 -->

	<module_sound name="tk_teppo_fire_near"
	  sound_category="mission_combat">
		<variation path="sho_closev2Musket_1.wav" weight="0.25" />
		<variation path="sho_closev2Musket_2.wav" weight="0.25" />
		<variation path="sho_closev2Musket_3.wav" weight="0.25" />
