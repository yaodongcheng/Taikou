<?xml version="1.0" encoding="utf-8"?>
<!-- TaikouCampaign heroes 最小集（v0）：
     main_hero 全家 = 建号流程依赖（CC 建号后玩家家庭树）；
     织田 2 名 + 今川 2 名 = 王国/家族 owner。今川家族当前已精简（无领地），条目保留以备数据恢复。 -->
<Heroes>
	<Hero
		id="main_hero"
		father="Hero.main_hero_father"
		mother="Hero.main_hero_mother"
		faction="Faction.player_faction" />
	<Hero
		id="main_hero_father"
		alive="false"
		faction="Faction.player_faction"
		spouse="Hero.main_hero_mother" />
	<Hero
		id="main_hero_mother"
		alive="false"
		faction="Faction.player_faction"
		spouse="Hero.main_hero_father" />
	<Hero id="lord_oda_nobunaga" faction="Faction.clan_oda" text="{=TAIKOU_hero_nobunaga}Oda Nobunaga"/>
	<Hero id="lord_oda_shibata_katsuie" faction="Faction.clan_oda" text="{=TAIKOU_hero_shibata}Shibata Katsuie"/>
	<Hero id="lord_imagawa_yoshimoto" faction="Faction.clan_imagawa" text="{=TAIKOU_hero_yoshimoto}Imagawa Yoshimoto"/>
	<Hero id="lord_imagawa_suemori" faction="Faction.clan_imagawa" text="{=TAIKOU_hero_suemori}Imagawa Suemori"/>
</Heroes>
