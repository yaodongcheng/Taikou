<!-- Taikou 的动画接线正本之一：动作名声明。
     动画资产本体 = AssetPackages/lwn_taikou_anim.tpac（由中转模块 TaikouAnim 编译后手工拷入）。
     本文件由 ModuleData/project.mbproj 的 soln_action_types 那一行注册 —— 不挂那行 = 文件从不解析。

     🔴 2026-09-19 启用。为什么不会重演 09-08 那次崩：那次是 Taikou 的 action_sets.xml **逐字拷贝 Native**
        → 同 soln id 合并出重复定义 → KeyNotFoundException。本次只声明【一个全新动作】 act_gun_reload，
        与 Native 的动作名**零交集** → 合并是纯追加，不冲突。
     回退方法：删掉 mbproj 里 soln_action_types 那一行即可。 -->
<action_types>
	<!-- 🔴 type / action_stage 照 Native 的 act_reload_crossbow 抄（同一套属性）：
	     引擎靠这两个属性把动作认成"装填"，并挂进装填状态机（mid = 主段）。
	     不带这两个属性 = 动作存在、能手动播，但引擎的装填流程不会用它。
	     注：action_stage 是"类别"不是"唯一占位"—— 织丰的 act_reload_musket 也用同一个 stage，
	     具体播哪条由 usage 的 reload_action 决定（见 item_usage_sets.xml）。 -->
	<action
		name="act_gun_reload"
		type="actt_reload"
		action_stage="as_reload_mid_phase" />

	<!-- 🔴 2026-09-20 新增：飞行待机（阶段 1A 探针）。
	     🔴 必须带 type="actt_idle" —— 用法组的 <idles> 只认带这个属性的动作（Native 73 条里 71 条带）。
	     本次同样与 Native 动作名**零交集**，合并是纯追加，不会重演 09-08 那次 KeyNotFoundException。
	     验：实机控制台 custom.do_anim act_fly_idle -->
	<action
		name="act_fly_idle"
		type="actt_idle" />

	<!-- 🔴 2026-09-20 新增：处决动画（T17「带位移动画」实验的载体）。
	     表演类动作：**不带** type / action_stage / usage_direction —— 只靠控制台 do_anim 手动播，
	     不挂进任何状态机。与 Native 动作名零交集，合并纯追加。
	     🔴 2026-09-22 改名：原 `act_execution02_root` 的 `_root` 后缀去掉 —— 动作名只说"演什么"，
	     "带不带位移"是 clip 自己的事，不写进动作名。旧名作废，勿再使用。
	     验：实机控制台 custom.do_anim act_execution02（播完 custom.print_pos_dir 位置有没有变）-->
	<action name="act_execution02" />

	<!-- 🔴 2026-09-22 新增：被处决那一侧（clip `executed02`，与上面是同一段表演的配套两侧）。
	     攻击方播 act_execution02、受击方播 act_executed02，两条要同时起播才对得上；
	     本次只做声明与接线（供控制台单播检查），两边怎么配对、怎么同步留给玩法实现。
	     验：实机控制台 custom.do_anim act_executed02 -->
	<action name="act_executed02" />

	<!-- 🔴 2026-09-21 新增：飞行动作 4 条（起飞 / 巡航 / 冲刺 / 落地）—— 玩家飞行用。

	     表演类动作，照上面 act_execution02 的样式**裸声明**（不带 type / action_stage /
	     usage_direction）：这 4 条由我们的 Flight 代码每帧 SetActionChannel 直接指定，
	     **不进引擎的走跑状态机**。理由：引擎那套移动模式只有 走 / 跑 / 蹲走 / 蹲跑 四个且名字写死在
	     native 里，表达不了「抬头爬升、低头俯冲」，所以飞行整体接管、不走它。

	     与 Native 动作名零交集，合并纯追加（不会重演 09-08 那次 KeyNotFoundException）。

	     验：实机控制台逐条 custom.do_anim act_fly_cruise / act_fly_boost / act_fly_start / act_fly_land -->
	<action name="act_fly_start" />
	<action name="act_fly_cruise" />
	<action name="act_fly_boost" />
	<action name="act_fly_land" />

	<!-- 🔴 2026-09-22 新增 7 条：冲刺入姿 / 四方向闪避 / 抬头 / 低头。
	     来源：A 套飞行动画进包（`lwn_taikou_anim.tpac`，53 资产那版）。
	     ① 冲刺入姿 `act_fly_dash_start` 与 四方向闪避 `act_fly_dodge_l/r/u/d`：
	        C# 侧动作名早已写在 FlightTuning（ActBoostStart / ActDodgeL..D），本条只是把 XML 补上。
	     ② 抬头 `act_fly_climb` / 低头 `act_fly_dive`：FlightTuning.ActClimb / ActDive 从空串填成这两个名字
	        （之前留空 = 抬头时"保持上一条姿态"，看着像平板上升）。
	     ⚠️ 现在接的是**巡航家（直立）**的抬头/低头姿态；冲刺时会从趴姿切到直立姿态，
	        要按"冲刺家也各有一套"再拆状态，见 plans/玩家飞行-实施方案.md §3.8.1。
	     验：实机控制台逐条 custom.do_anim act_fly_dash_start / act_fly_dodge_l / act_fly_climb / act_fly_dive -->
	<action name="act_fly_dash_start" />
	<action name="act_fly_dodge_l" />
	<action name="act_fly_dodge_r" />
	<action name="act_fly_dodge_u" />
	<action name="act_fly_dodge_d" />
	<action name="act_fly_climb" />
	<action name="act_fly_dive" />

	<!-- 🔴 2026-09-22 新增 6 条：压弯（左/右）× 两个家族 + 冲刺家的抬头/低头。
	     为什么两个家族分开：**巡航家是直立姿势、冲刺家是趴姿**（实测身体轴一个竖直、一个水平），
	     混用会硬翻 90°。
	     触发：压弯 = 横移输入 A/D（带迟滞，`custom.flight tune bank / bankout` 可调）；
	     冲刺抬头/低头 = 相机俯仰（冲刺态时走这两条，不再走 act_fly_climb / act_fly_dive）。
	     未接的：`flight_hovermove_a_pitchf / _pitchb`（前倾/后仰）留待定用途，包里已有资源。
	     验：实机 custom.do_anim 逐条（进飞行后按 A/D、抬头低头更直观） -->
	<action name="act_fly_lean_l" />
	<action name="act_fly_lean_r" />
	<action name="act_fly_boost_lean_l" />
	<action name="act_fly_boost_lean_r" />
	<action name="act_fly_boost_climb" />
	<action name="act_fly_boost_dive" />

	<!-- ═══════════ 施法手势（2026-09-24）· 🔴 **只在【通道 1 = 上身】播**，腿保持飞行姿态 ═══════════
	     来源 = FlexibleCombatSystem 的魔法动画（经 `tools/anim-retarget` 重定向）：
	       MagicIdle         (55 帧 / 1.80 s) → 蓄力循环（按住右键期间一直播，靠 anf_cyclic 自己转）
	       ProjectileSpell   (70 帧 / 2.30 s) → 释放（松左键那一拍播一次；出手帧在 36%）
	     内容包侧：clip 在 `AssetPackages/lwn_taikou_anim.tpac`（名 `magic_idle` / `magic_projectile_spell`）。
	     代码侧：`Combat/SpellCastInput.cs` 的 PlayChargeAnim / PlayReleaseAnim。
	     写错 = 静默 act_none（`ActionIndexCache.Create` 查不到就跳过，不会崩）。
	     验：实机进飞行 → 按住右键看上身有没有起手姿势。 -->
	<action name="act_cast_charge" />
	<action name="act_cast_projectile" />
</action_types>
