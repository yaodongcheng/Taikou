		<XmlNode>
			<XmlName id="Items" path="taikou_items"/>
			<IncludedGameTypes>
				<GameType value="Campaign"/>
				<GameType value="CampaignStoryMode"/>
				<GameType value="TaikouCampaign"/>
				<GameType value="TaikouCampaign1560"/>
				<GameType value="TaikouCampaign1582"/>
